# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/consumer_research

# Redis / queue
REDIS_URL=redis://redis:6379

# Auth
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Fireworks.ai Batch Inference
FIREWORKS_API_KEY=
FIREWORKS_ACCOUNT_ID=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct
FIREWORKS_BASE_URL=https://api.fireworks.ai
FIREWORKS_BATCH_EXPIRY_HOURS=24
# Poll interval (ms) for batch job status in the worker
FIREWORKS_POLL_INTERVAL_MS=30000
# Set to "true" to skip real Fireworks calls and fake sentiment locally (dev/demo)
SENTIMENT_MOCK=false

# Glean hosted agent (overall analysis)
GLEAN_API_TOKEN=
GLEAN_AGENT_ID=
GLEAN_BASE_URL=https://api.glean.com
# Set to "true" to skip real Glean calls and fake the analysis locally (dev/demo)
GLEAN_MOCK=false

# Uploads
UPLOADS_DIR=/data/uploads
MAX_UPLOAD_MB=200

# Panelist import behavior
AUTO_CREATE_STUB_PANELISTS=true

# First-run bootstrap admin (created on migrate if no users exist)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234
MAX_ZIP_ENTRIES=200
